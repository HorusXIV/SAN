\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Connected Components im Pass-Netzwerk (Deutschland). Die grösste Komponente umfasst 473 Knoten (59.8\% des Netzwerks), die übrigen sind Teams ohne Transferspieler}}{25}{figure.caption.33}\protected@file@percent }
\newlabel{fig:pass_network_connected}{{3.1}{25}{Connected Components im Pass-Netzwerk (Deutschland). Die grösste Komponente umfasst 473 Knoten (59.8\% des Netzwerks), die übrigen sind Teams ohne Transferspieler}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Algorithmenvergleich auf dem Pass-Netzwerk (Deutschland). Louvain erzielt die höchste Modularität ($Q = 0.886$), Label Propagation die höchste Coverage aber mit einer sehr grossen Ausreisser-Community (Max 51).}}{26}{figure.caption.35}\protected@file@percent }
\newlabel{fig:pass_communities_algorithm_comparison}{{3.2}{26}{Algorithmenvergleich auf dem Pass-Netzwerk (Deutschland). Louvain erzielt die höchste Modularität ($Q = 0.886$), Label Propagation die höchste Coverage aber mit einer sehr grossen Ausreisser-Community (Max 51)}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Grössenverteilungen der Communities für vier Algorithmen. Louvain und Greedy liefern sehr uniforme Grössen (23--31), Label Propagation zeigt einen Ausreisser (bis 51), Girvan-Newman produziert eine Singleton-Community.}}{27}{figure.caption.36}\protected@file@percent }
\newlabel{fig:community_size_dist}{{3.3}{27}{Grössenverteilungen der Communities für vier Algorithmen. Louvain und Greedy liefern sehr uniforme Grössen (23--31), Label Propagation zeigt einen Ausreisser (bis 51), Girvan-Newman produziert eine Singleton-Community}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Louvain-Communities im Match-Netzwerk (World Cup). Farbcodierung zeigt 6 Communities, die primär Vorrunden-Gruppen mit K.O.-Verknüpfungen widerspiegeln.}}{28}{figure.caption.38}\protected@file@percent }
\newlabel{fig:match_communities_louvain}{{3.4}{28}{Louvain-Communities im Match-Netzwerk (World Cup). Farbcodierung zeigt 6 Communities, die primär Vorrunden-Gruppen mit K.O.-Verknüpfungen widerspiegeln}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Positionsverteilung innerhalb der Köln-Communities (100\% gestapelt). Die drei Communities zeigen hohe Positions-Diversität: Community 1 (19 Spieler) ist primär Defensive/Mittelfeld, Community 2 (8 Spieler) ebenso defensivlastig, Community 3 (4 Spieler) zeigt leichte offensive Prägung mit Torwartanteil.}}{29}{figure.caption.39}\protected@file@percent }
\newlabel{fig:team_position_distribution}{{3.5}{29}{Positionsverteilung innerhalb der Köln-Communities (100\% gestapelt). Die drei Communities zeigen hohe Positions-Diversität: Community 1 (19 Spieler) ist primär Defensive/Mittelfeld, Community 2 (8 Spieler) ebenso defensivlastig, Community 3 (4 Spieler) zeigt leichte offensive Prägung mit Torwartanteil}{figure.caption.39}{}}
